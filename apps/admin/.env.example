# Somnation admin app (apps/admin). Copy to .env.local — never commit real values.

# The site that serves the admin API (/api/admin/*).
SITE_API_URL=http://localhost:3000
# Public site address for "open on the site" links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret; must equal ADMIN_API_TOKEN in apps/web. Required in production.
ADMIN_API_TOKEN=replace-with-a-long-random-secret
# Mock operator sign-in (development). Set to false once real operator auth exists (TBD).
ADMIN_USE_MOCK=true
