# Ssumnation admin app (apps/admin). Copy to .env.local — never commit real values.
# Production runs on the admin subdomain (e.g. admin.<site domain>; the real domain is TBD).

# Host(s) the console answers on; other hosts get 404. Leave empty for local development.
# e.g. ADMIN_HOST=admin.example.com
ADMIN_HOST=
# The site that serves the admin API (/api/admin/*). Prefer an internal address in production.
SITE_API_URL=http://localhost:3000
# Public site address for "open on the site" links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret; must equal ADMIN_API_TOKEN in apps/web. Required in production: at least 32 random characters
# (the site refuses this placeholder and anything shorter).
ADMIN_API_TOKEN=replace-with-a-long-random-secret
# Mock operator sign-in. Development: on unless set to false. Production: off unless set to exactly true
# (demo deployments only — anyone reaching the console could sign in). Real operator auth is TBD.
ADMIN_USE_MOCK=
