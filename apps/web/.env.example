# Shared secret for the separate admin app (apps/admin → /api/admin/*). Required in production: at least 32
# random characters — this placeholder and shorter values are refused (the admin API answers 503).
ADMIN_API_TOKEN=replace-with-a-long-random-secret

# Ssumnation 도우미 domain (docs/development/helper-domain.md): comma-separated host[:port] — an entry without a port
# matches any port. Unset = any "helper." host, e.g. http://helper.localhost:3000 in development. The real domain is TBD.
HELPER_HOST=

# FLEXTV backend (docs/development/flextv-backend.md). "flextv" connects the phases built so far to FLEXTV's API
# (1: 로그인 · 회원가입 · 세션, 2: 렉스 잔액 · 충전 · 내역, 3: FLEXTV 채널 후원 · 후원 내역); unset keeps the mock. FLEXTV_API_URL is FLEXTV's API server
# (its stage while testing), called from the server only.
NEXT_PUBLIC_BACKEND=
FLEXTV_API_URL=
# Optional x-site-code. Unset = FLEXTV's own members (2026-10-25 결정: 기존 FLEXTV 회원 그대로).
FLEXTV_SITE_CODE=
# FLEXTV's site, for flows phase 1 links to (비밀번호 찾기). Default https://www.flextv.co.kr
NEXT_PUBLIC_FLEXTV_WEB_URL=

# 간편 로그인 through FLEXTV's own apps (never new ones: FLEXTV checks the app, and Kakao · Naver ids differ per app).
# Register https://<site>/auth/{kakao,naver,google}/callback with each. A provider without its values is not offered.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
