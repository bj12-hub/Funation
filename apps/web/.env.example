# Shared secret for the separate admin app (apps/admin → /api/admin/*). Required in production: at least 32
# random characters — this placeholder and shorter values are refused (the admin API answers 503).
ADMIN_API_TOKEN=replace-with-a-long-random-secret

# Ssumnation 도우미 domain (docs/development/helper-domain.md): comma-separated host[:port]. Unset = any "helper." host,
# e.g. http://helper.localhost:3000 in development. The real domain is TBD.
HELPER_HOST=
