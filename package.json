{
  "name": "funation",
  "private": true,
  "version": "0.1.0",
  "description": "Funation broadcasting donation platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "lint:web": "npm run lint --workspace=apps/web",
    "dev:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-sync.ps1"
  }
}
