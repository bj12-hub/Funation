{
  "name": "ssumnation",
  "private": true,
  "version": "0.1.0",
  "description": "Ssumnation broadcasting donation platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "lint:web": "npm run lint --workspace=apps/web",
    "test:web": "npm run test --workspace=apps/web",
    "dev:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-sync.ps1",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build:admin": "npm run build --workspace=apps/admin",
    "lint:admin": "npm run lint --workspace=apps/admin",
    "test:admin": "npm run test --workspace=apps/admin"
  }
}
